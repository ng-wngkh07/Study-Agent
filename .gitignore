# Agent Học Tập: chỉ cho phép tài sản dùng chung ở thư mục gốc.
# Phạm vi chia sẻ: CONTRIBUTING.md. Không dùng git add -f để vượt quy tắc.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/LICENSE.*
!/requirements.txt
!/requirements-dev.txt
!/requirements-mlx.txt
!/constraints-web-py312.txt
!/constraints-mlx-py313.txt
!/README_MAC.md
!/pytest.ini
!/run.py
!/start_app.command
!/README_WINDOWS.md
!/README_QUY_TAC.md
!/LICH_SU_DU_AN.md
!/requirements-windows.txt
!/pytest.windows.ini
!/setup_windows.ps1
!/start_windows.ps1
!/test_windows.ps1
!/app/
!/static/
!/scripts/
!/tests/
!/docs/
!/corpus/
!/.env.example

# Tài liệu nhóm đã biên tập; hồ sơ/handoff/audit cá nhân vẫn giữ local.
/docs/*
!/docs/team/

# corpus/ chỉ chứa metadata văn bản; PDF/ảnh/gói nặng lưu ở kho riêng.
/corpus/**
!/corpus/**/
!/corpus/**/*.md
!/corpus/**/*.json
!/corpus/**/*.jsonl

# src/ là tài liệu gốc; data/ chứa SQLite/vector/model/dữ liệu cá nhân.
/src/
/data/
/scratch/
/AGENTS.md
/.agents/
/.codex/
/.gemini/
/.antigravity/

# Môi trường, cache, log, trạng thái máy và bí mật ở các thư mục được phép.
.venv/
.train-venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.DS_Store
Thumbs.db
*.log
*.lock
*.pid
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
.env
.env.*
!.env.example
*.pem
*.key
*.safetensors
*.gguf

# PDF phan cong dung chung; chi cho phep dung artifact nay.
!/output/
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/PHAN_CHIA_NHIEM_VU_DO_AN_NHOM.pdf

# Windows installer manifest and helpers are shared; installers stay on each machine.
!/requirements-windows-tools.json
# One-off local trials and personal review/monitor tasks are not team tools.
/scripts/curate_v9_release.py
/scripts/monitor_operations_smoke.py
/scripts/codex_review_broad_answers.py
