# Used by scripts/dev.py and the Windows launchers. Existing process env wins.
# Demo profile always uses tests/fixtures/documents and data/team-demo.
# Local profile can use the following relative paths:
AGENT_SRC_DIR=src
AGENT_DATA_DIR=data
OLLAMA_BASE_URL=http://localhost:11434
# Windows/team demo uses an Ollama base. It is not the trained Mac adapter.
DEFAULT_CHAT_MODEL=qwen2.5:3b
DEFAULT_EMBED_MODEL=bge-m3
OLLAMA_AUX_CHAT_MODEL=qwen2.5vl:3b
HOST=127.0.0.1
PORT=8000
